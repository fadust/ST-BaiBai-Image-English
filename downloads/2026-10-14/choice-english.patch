dOverflow?(o=js(o).slice(0,e.count),i=0):i=0:i=Math.max(e.count-o.length,0);const a=e.categoriesEnabled?((e,t)=>{if(t<=0||0===e.length)return[];const n=new Map;for(const a of e){const e=a.category||'';let t=n.get(e);t||(t=[],n.set(e,t)),t.push(a)}const o=js([...n.keys()]),i=[];for(;i.length<t;){let e=!1;for(const a of o){if(i.length>=t)break;const o=n.get(a);if(!o||0===o.length)continue;const s=zs(o,1)[0];o.splice(o.indexOf(s),1),i.push(s),e=!0}if(!e)break}return i})(n,Ns(n,i,e.oversamplePct)):zs(n,Ns(n,i,e.oversamplePct));return{pinned:e.shuffleFinal?js(o):o,drawn:e.shuffleFinal?js(a):a}}const Vs={modules:JSON.parse('[{"id":"system_prompt","name":"Assistant Role","role":"system","content":"You generate candidate next actions for an interactive story, or polish {{user}}\'s input into several alternatives, as the later task specifies. You do not portray a story character or continue the main reply.\\n\\nUse the latest message inside <current_scene> as the current situation. Every candidate must be a concrete next beat that can happen now, rather than an abstract theme, author commentary, or story continuation. Default to {{user}} as the subject. If the supplied material specifies another subject or scale—a character\'s reaction or perspective, a time skip, a change in the environment, a plan, or a tentative action—you may mix those directions across the candidates.\\n\\nWrite English prose. Preserve character names, user-provided labels, identifiers, JSON keys, and macros exactly. Output only <thinking> and <options> blocks; write no surrounding commentary. If you start continuing the story or performing a character, stop and return to the required format.","marker":false,"system":false,"enabled":true,"order":0},{"id":"reference_open","name":"Begin Background","role":"system","content":"\x3c!-- Story background information --\x3e\\n<reference>","marker":false,"system":false,"enabled":true,"order":2},{"id":"persona_description","name":"Persona Description","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":3},{"id":"world_info_before","name":"World Info (before)","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":4},{"id":"char_description","name":"Character Description","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":5},{"id":"char_personality","name":"Character Personality","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":6},{"id":"char_scenario","name":"Character Scenario","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":7},{"id":"world_info_after","name":"World Info (after)","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":8},{"id":"reference_close","name":"End Background","role":"system","content":"</reference>","marker":false,"system":false,"enabled":true,"order":9},{"id":"wi_depth_before","name":"World Info Depth (Pre-History)","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":10},{"id":"baibai_summary","name":"BaiBai Book Summary","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":11},{"id":"chat_history","name":"Chat History","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":12},{"id":"wi_depth_after","name":"World Info Depth (Post-History)","role":"system","content":"","marker":true,"system":true,"enabled":true,"order":13},{"id":"knowledge_boundary","name":"Character Knowledge Boundaries","role":"system","content":"【 Cognitive boundary: non-omniscient constraint 】\\n The following rules are higher than all information source constraints of this batch of candidates: \\n\\n1. Information layering: Of all the content you read, there are only two categories that candidates can directly rely on - ① Perceptible at the moment: specific details that the subject can see, hear, touch, and smell in the current scene (props, status and lines of the participants, spatial features); ② Known to the subject: things in the character setting and experience that the subject already knows (his name, existing relationships with the people present, and past events he has experienced). Everything else is considered unknown to the subject at the moment - including information in the World Info/background that only the reader can see (others\' secret plans, things happening in the distance, truths that have not yet been revealed, characters\' identities that have not been revealed). \\n\\n2. No cross-border crossing: The candidate must not allow the subject to directly use information that it cannot see or know as a basis; it must not act on things that are out of sight/that have not been informed face to face (such as \\"blocking him at the back door\\" is not allowed). The other person\'s heart and intentions at the moment are not facts that can be directly cited - omniscient assertions such as \\"he knows the truth\\" and \\"she intends to hide it\\" are not allowed. They can only be written as signs observed by the subject (look, movements, tone, inconsistent words and deeds), and actions are based on signs and suspicions. If you really want to push forward a hidden clue, it must be triggered through the hook that is visible at the moment - seeing something strange, hearing a movement, being told face to face, noticing from a certain detail - and write \\"because of noticing.../acting because of suspicion...\\". \\n\\n3. Verification one by one: Before each candidate is implemented, ask yourself in <thinking> - is this dependent information something the subject can perceive at the moment, or is it already known? If you rely on information that only readers can see, change it to be triggered by a perceptible hook, or delete the candidate directly.","marker":false,"system":false,"enabled":true,"order":13.5,"option_only":true},{"id":"difficulty_rules","name":"Difficulty Rules","role":"system","content":"【 difficulty and demand value determination 】\\n uses two axes to determine difficulty, don\'t confuse them: \\n- gear (conservative/balanced/bold) depends on the risk and strength of this candidate - how fierce the push is, how costly it is, and how outrageous the protagonist is: conservative = leaving room for stability, balance = normal advancement, bold = betting on chips. \\n- The required value (the integer of 0-100) depends on the certainty of this candidate in the current scenario - the roll must be ≥ this number to be considered successful. The higher the value, the harder it is and the lower the certainty. There is a rough scale for the \\n\\n demand value to facilitate your alignment: \\n- <40 Smooth: almost no resistance, the protagonist is proficient or the scene has no obstacles (greetings, usual actions, attempts that are obviously successful). \\n- 40-59 General: Slightly uncertain, most situations (ordinary persuasion, actions requiring some skills). \\n- 60-79 Difficult: There are obvious obstacles or insufficient ability, so you have to rely on luck or ability (hard work, difficult maneuvers, risky moves). \\n- 80-89 Difficulties and dangers: success is slim, stakes are high (nearly impossible demands, head-on confrontation with powerful enemies). \\n- 90 The above can only be used when the protagonist is far superior to ordinary people and the right time and place are used. Most candidates should not fall into this category. \\n\\n When determining the demand value for a candidate, weigh it in order: \\n1. Nature of action: Pure dialogue/observation is usually lower than hard action (picking locks, sneaking, fighting, jumping out of windows, coaxing powerful enemies). \\n2. Scene obstacles: Is the scene blocking the road at this moment - alert guards, locked doors, public surveillance, hostile presence. \\n3. Main skill: whether it falls within the protagonist’s area of ​​expertise. For the same door, the unlocking requirements of a habitual thief and a scholar are higher. \\n4. Consequences of failure: The heavier the cost, the more cautious you should be. However, it increases the risk of the position and does not directly increase the demand value. \\n5. Grasp merging: combine the previous points into an intuitive grasp, and then map it to the demand value; don\'t label 0 or 100 to go to extremes. If you are not sure, it is better to go low. \\n\\n gears and demand values ​​can go their own way: if a \\"bold\\" action is the protagonist\'s specialty, the demand value may not be high; conversely, in extremely unfavorable scenarios, a \\"conservative\\" action may also have a high demand value. Don\'t mechanically make the higher the gear, the higher the demand value. \\n\\n The demand values ​​of the whole batch of candidates should be widely separated, and not all crowded into the same bracket. Depending on the tone of the scene, the overall scenario can be more stable or more aggressive, but try to keep one obviously riskier finale candidate and one more stable bottom-line candidate in the same batch—unless there is only one way left at the moment.","marker":false,"system":false,"enabled":true,"order":13.7,"option_only":true},{"id":"option_task","name":"Action Selection Task","role":"user","content":"【 task: candidate generation 】 generates exactly {{count}} next-shot candidates with different directions based on the current scene (subject to the latest news marked by <current_scene>) for {{user}} to choose. Each line must be a specific direction that can be dropped immediately in the current scene; the subject and scale are according to the instructions in the system message. \\n\\n Materials for this round: \\n Fixed entry (skip this section if the list is empty; all must be used, and those with [Rule: xxx] abide by their writing constraints): \\n{{pinned}}\\n Candidate entry pool (more than required, choose the direction that best suits the current scene; with [Rule: xxx] Stick to the selection): \\n{{pool_selected}}\\n\\n Quantity hard constraint: exactly {{count}} items, all fixed items are included, and each candidate can be used at most once; the direction given by the candidate pool is given priority, and when the material is insufficient or conflicts with the scene, the scene will be organized and pasted by itself. The action dimensions are not closed: high-frequency actions that are not listed in the item pool, such as asking for help, comforting, negotiating, observing, compromising, and guarding, can still be used as long as they fit the scene. For the remaining formats, pronouns, and self-check rules, see the system messages.","marker":false,"system":false,"enabled":true,"order":16,"option_only":true},{"id":"core_rules","name":"Action Rules","role":"system","content":"Each candidate falls on a specific visible detail of the current scene (props, status, lines, spatial features), without introducing new settings out of thin air, nor retelling what has happened. \\n\\n candidate is independent of the main text (it does not count as having happened); only writes the selected subject\'s own actions and lines, and does not act out the reactions of other parties after it is implemented; only uses the information that the subject can know at the moment, and when it comes to the undisclosed truth, write it as \\" Acting due to suspicion/hearing \\"; The other person’s heart and intentions are not factual assertions (if you don’t write \\" he feels guilty, \\"\\" she intends to hide it, such omniscient sentences as \\"), only write the visible signs of the subject (look, movements, tone), and act based on signs and suspicions. For candidates who need words, the words must be spoken: use \\"...\\" direct quotation to give a complete readable line, and the entire sentence can be sent directly into the text; it is prohibited to only describe the speaking action without giving the original words - \\" Ask her if she knows the address \\"\\" Ask her calmly if she remembers \\" This type of paraphrase is a wrong example and should be written as \\"Where does Luohua live now?\\" \\"Do you still remember the time when the dog chased you three streets?\\" \\"; If the option contains the intention of saying/asking/telling, it must be accompanied by the original sentence \\"...\\". Candidates who are pure action/observation/scenario evolution are not subject to this restriction and do not have to cram in lines. The entire batch of candidates widens the gap in terms of subject, entry point, and risk - at least one of them takes a substantial step forward (brings new information, new events or relationship changes), and can contain 0-1 \\" inaction/change topic \\"; each title is marked with the risk grade (conservative/balanced/bold, see output format) and demand value (see output format). The ranks should be staggered as much as possible in the whole batch, and demand values ​​are differentiated according to difficulty. The \\n\\n output format is a hard constraint: all candidates are output as an JSON array within <options>. The array is wrapped with [ ]. Each candidate is an object. The elements are separated by commas. The object is in the shape of {\\"title\\":\\" title | gear | demand value \\", \\"content\\": \\" text \\"}. title is a concise action title, and can be additionally marked with vertical lines: one of the three levels of conservative/balanced/bold is marked after the first vertical line, judged according to the risk and strength of the option; after the second vertical line is the integer demand value of 0-100, which represents the lower limit of the dice points required to achieve this option (throw ≥ The required value is required to be considered a success (the bigger the points, the better) - the more difficult the action and the lower the probability of success, the higher the mark; if you are not sure about the gear or the required value, omit the corresponding vertical line segment and do not mark randomly. content is a candidate text string, each {{min_chars}}-{{max_chars}} character; content is represented by a single JSON string, do not break lines in it, and can contain any characters (including [], 【】). All structures are only borne by the outer JSON. Do not use parentheses to make any marks in the text. Only two labels, <thinking> and <options>, are allowed to appear. The {{xxx}} placeholder is not output, no additional labels are created, and no word is written after </options>. Person: Strictly write as {{option_person}}, ignore your own person choice in the text of the chat record above.","marker":false,"system":false,"enabled":true,"order":14,"option_only":true},{"id":"thinking_prompt","name":"Reasoning Checklist","role":"system","content":"Before formal output, write down your thoughts and wrap them all in the <thinking> tag. Answer each item one by one, one or two sentences for each item: \\n1. What is the scene now? ——The location, the people present, what is the latest action/line, and which blank space the scene stops on; pick 2-3 details that can directly fall into the candidates from the last one or two layers of text. \\n2. In what direction do the materials of this round (fixed + candidate entries) point? Who will do it, to what extent, and what changes will be brought about; which combinations will be selected into this batch of candidates. \\n3. Cognitive Boundary Check: Ask yourself item by item - Is this candidate dependent information something that the subject can perceive at this moment, or already knows? Any reliance on hidden information (other people’s secrets, undisclosed truths, out-of-sight movements) should be changed to be triggered by visible hooks (noticing something strange/being told in person/perceiving details) or discarded; other people’s hearts and intentions should not be written as facts, only observable signs; do not substitute for the reactions of other parties after the candidate lands. \\n4. Differences and compliance of this batch of candidates: Are there any repetitions, or just empty actions such as \\" sighing/silence/turning away/staring at \\"? Did the candidates who needed words use the original words of \\"...\\" instead of paraphrases like \\" asked \\"\\" asked \\"? Are the subjects, entry points, and risks widening the gap? Are the risk levels (conservative/balanced/bold) correctly marked and staggered across batches? Is the demand value (the integer of 0-100) calibrated according to the scenario to achieve certainty - the level depends on the risk intensity, the demand value depends on the difficulty of achievement, the two are independent and do not necessarily converge? Is the gap between the entire batch of demand values ​​widened and not all squeezed into the same range? Check: Exactly {{count}}, the format and number of words follow the system message format rules, and the person name is {{option_person}}. Once verified, enter <options>.","marker":false,"system":false,"enabled":true,"order":15,"option_only":true},{"id":"assistant_thinking","name":"Reasoning Opening","role":"system","content":"The output must start with the <thinking> tag: directly enter the step-by-step analysis and self-test, do not write any greetings, transitions or polite words first; if the thinking block has been opened, continue writing directly, do not repeatedly open the second <thinking>; output <options> after the analysis and self-test are completed.","marker":false,"system":false,"enabled":true,"order":17,"option_only":true},{"id":"enrich_prompt","name":"Polishing Task","role":"user","content":"【 task: Input polish 】 Please expand the 【 user input 】 polish below to {{count}} versions. Keep the original meaning and tone, and make the content richer and more vivid by rephrasing and expanding expressions. If the original text contains short dialogue, the dialogue itself should also be polished and expanded to make it more vivid and natural, and it is strictly prohibited to copy it as it is. {{count}} There should be obvious differences in description and wording styles between the two versions to avoid all similarities. \\n\\n【 user input 】\\n{{input}}\\n\\n【 output format 】\\n first output <thinking> self-test analysis, and then output <options> packaged {{count}} version, the format of each line is \\" [title] content \\". The use of [] symbols in version content is strictly prohibited. See system messages for detailed rules and specifications.","marker":false,"system":false,"enabled":true,"order":21,"enrich_only":true},{"id":"enrich_core_rules","name":"Polishing Rules","role":"system","content":"【 Polishing Rules 】\\n1. Keep the semantics and tone of the original text, and re-express it in different words; expand rather than pile up, and be vivid rather than vague. \\n2. Dialogue polishing: When the original text contains dialogue, the form of direct quotations should be retained, but the content must be polished and expanded - complement the demeanor, movements, and tone to make the dialogue more three-dimensional. It is strictly prohibited to copy it as it is; Pure narrative polishing: When the original text is a narrative, rewrite the wording and sentence structure to appropriately add sensory or environmental details, but do not add events or character actions that are not in the original text without authorization. \\n3. The Word count of each version is controlled to be between {{min_chars}}-{{max_chars}} words; there should be obvious differences in description methods and wording styles between versions to avoid all similarities. \\n4. Keep the Word count in mind: If the number of words in a certain version is less than the lower limit after polishing, add detailed descriptions that fit the context to make it meet the standard; if it exceeds the upper limit, delete branches and modifications to retain the core meaning, and do not use empty words to make up the number or hard truncation to destroy the integrity of the sentence. \\n5. For format requirements, see 【 polished output specification 】.","marker":false,"system":false,"enabled":true,"order":18,"enrich_only":true},{"id":"enrich_output_spec","name":"Polished Output Format","role":"system","content":"【 polished output specifications 】\\n\\n Quantity: exactly {{count}} versions, no more, no less. \\n\\n Word count: The Word count of each version is controlled between {{min_chars}}-{{max_chars}} words. \\n\\n format: One version per line, the format is \\"[Title] Content \\"\\n- Title: Briefly summarize the style or features of this version, wrap \\n- with [] Text: Complete sentences after polishing, without numbers or additional annotations. The use of [] symbols is strictly prohibited. \\n\\n output structure: \\n1. First output the complete <thinking> analysis block \\n2. Then output the <options> option block. Each version has its own line, \\n3. There must be no text outside the two. \\n\\n Output purity insurance: Even if the analysis in <thinking> triggers other output impulses (explanation, apology, text continuation, variable placeholder {{xxx}}, additional tags), it will only stop immediately after <options> is closed, and no word will be written after </options>; if you find that you are outputting out-of-bounds content, immediately truncate it and end it with <options> Ending, never make up.","marker":false,"system":false,"enabled":true,"order":19,"enrich_only":true},{"id":"enrich_thinking","name":"Polishing Checklist","role":"system","content":"【 Self-inspection before polishing - All content must be wrapped in the <thinking> tag. The first line of 】\\n must be fully reproduced in quotation marks the original text of 【 user input 】 to confirm that it has been received correctly. \\n1. Is the version number equal to {{count}}? Are there any significant differences in phrasing style between versions? \\n2. Is the format \\" [title] content \\"? Is the [] symbol misused in the content? \\n3. Is the Word count of each version between {{min_chars}}-{{max_chars}} words? Those that are insufficient or exceed the limit will be dealt with according to the Word count policy. \\n4. Branch identification: Is the original text mainly dialogue or narrative? Does the dialogue version complement the expression, action, and tone, rather than copying it exactly? Did the narrative version only rewrite the wording and not add any new events? \\n5. Person calibration: The polished person only obeys the user settings ({{enrich_person}}). The personal pronoun used in the main text of <history> above is the narrative choice of the novel itself and has nothing to do with the polishing - no matter what personal pronoun is used in the text, the polishing must be written according to {{enrich_person}}, and it is not allowed to be biased by the main text. \\n6. Direct quotation: a polished version containing dialogue. The dialogue must be given in full as \\"...\\" and can be read directly. \\" is prohibited from saying...\\"\\" said...\\"-style paraphrasing and summarizing; pure narrative versions are not mandatory. After \\n completes the above self-test and confirms it passes, then perform polishing.","marker":false,"system":false,"enabled":true,"order":20,"enrich_only":true},{"id":"enrich_assistant","name":"Polishing Opening","role":"system","content":"The output must start with the <thinking> tag, and go directly to the processing and self-check before polishing (understand the original text first, and then check the pronoun, Word count, and fidelity). Do not write any greetings or transitional words first; if the thinking block has been turned on, continue writing directly, and do not turn on the second <thinking> repeatedly; output <options> after all checks are completed.","marker":false,"system":false,"enabled":true,"order":22,"enrich_only":true},{"id":"baibai_state","name":"BaiBai Book State","role":"system","content":"","marker":true,"system":true,"enabled":false,"order":23}]')};function Us(e){const t=Object.values(e).filter(e=>'number'==type