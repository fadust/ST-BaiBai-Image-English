+.so-z2-block .so-apply-btn {
+    background: rgba(var(--so-ink), 0.08); background-image: none; box-shadow: none;
+    border-color: var(--SmartThemeBorderColor, rgba(255, 255, 255, 0.2));
+    color: var(--SmartThemeBodyColor, #e6e6e6);
+}
+.so-z2-block .so-apply-btn:hover:not(:disabled) { background: rgba(var(--so-ink), 0.14); filter: none; }
+
+/* 🩺 1.89.0：从存档检查跳到某一格时闪 2 秒（复用脏行的左缘强调色，明暗两皮都可见；不钉颜色）。 */
+.so-mvued-flash { box-shadow: inset 3px 0 0 var(--SmartThemeQuoteColor), 0 0 0 2px var(--SmartThemeQuoteColor); border-radius: 4px; }
