-  key: 'quality' | 'negative';
-  label: string;
-  hint: string;
-  /** 内置配方的绑定位只读:弹窗纯查看,不给保存(写进模块常量就糟了)。 */
-  readonly?: boolean;
-  fallback: () => string;
-  read: () => string;
-  write: (v: string) => void;
-}
