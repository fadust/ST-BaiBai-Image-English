-  /* 15% opacity */
-  --bbi-warning: #d9a441;
-  --bbi-warning-soft: #d9a44126;
-  /* 15% opacity */
-  --bbi-overlay: #00000073;
-  /* 45% 中性遮罩,不随 body 色反转 */
