+    modelKind: 'unet',
+    modelLabel: 'Model',
+    vaeRequired: true,
+    vaeLabel: 'VAE',
+    vaePlaceholder: 'qwen_image_vae.safetensors',
+    clips: [{ key: 'clip1', label: 'Qwen2.5-VL' }],
