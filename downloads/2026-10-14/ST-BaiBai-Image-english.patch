+
+export interface LlmRecord extends BaseRecord {
+  kind: 'llm';
+  /** 用途标签:'自动 tag' / '角色外貌转换' / 'ComfyUI 工作流配置' 等,由调用点传入。 */
+  source: string;
+  /** 渠道名;未指派渠道(跟随主 API)时为 FOLLOW_MAIN_API。 */
+  channelName: string;
+  model: string;
+  stream: boolean;
+  /** 完整提示词(已按 MAX_CONTENT 截断)。 */
+  messages: ChatMsg[];
+  /** 返回正文(已截断)。 */
