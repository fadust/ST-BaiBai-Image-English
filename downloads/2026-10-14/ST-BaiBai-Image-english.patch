-`,E4=`/*
- * 主题令牌(design tokens)— 柏宝绘 · 青瓷 × 纸墨
- * 灵感:古籍的暖纸、深墨,与一抹青瓷(celadon-jade)点缀。
- * 配色全部以 OKLCH 设计、感知均匀;所有文字对比度经 WCAG 2.1 校验:
- *   正文 ≥ 4.5:1(AA),弱化文字与非文本 UI ≥ 3:1。
- * 所有颜色/字体/尺寸都从这里取,组件不写死颜色。
- * 切换主题 = 改根节点 [data-theme];未来自定义主题只需新增一套同名变量。
- *
- * 配色:黑金优雅 —— 深海军蓝(h≈264)× 琥珀金(h≈70),源自经典黑金方案。
- * 金很亮,强调按钮上一律压「深 navy 字」(昼间用白字、金压暗),切勿白字配亮金。
- */
-
-.bbi-root {
-  /* —— 字体:现代无衬线栈,优先国产现代字体,回退系统 —— */
-  --bbi-font-sans: 'MiSans', 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei',
-    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', system-ui, sans-serif;
-  --bbi-font-mono: 'SF Mono', 'JetBrains Mono', 'DejaVu Sans Mono', Menlo, Consolas, monospace;
-
-  /* —— 圆角:更大、更柔 —— */
-  --bbi-radius-win: 16px;
-  --bbi-radius: 10px;
-  --bbi-radius-sm: 8px;
-  --bbi-radius-pill: 999px;
-
-  /* —— 间距节奏 —— */
-  --bbi-gap: 16px;
-  --bbi-page-pad: clamp(20px, 4vw, 40px);
-
-  /* —— 尺寸 —— */
-  --bbi-win-max-w: 880px;
-  --bbi-win-max-h: 82vh;
-
-  /* —— 动效 —— */
-  --bbi-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
-  --bbi-dur: 0.28s;
-}
-
-/* ========== 昼 · 象牙白 ==========
-   底色是暖中性象牙白;墨色取深海军蓝(与夜呼应),强调是压暗的金。
-   对比度(白底为基准):ink 16.0、ink-soft 7.1、ink-muted 3.6、accent 4.1。 */
-.bbi-root[data-theme='day'] {
-  --bbi-bg: oklch(0.97 0.004 90);
-  /* #f6f5f2 象牙白 */
-  --bbi-surface: oklch(1 0 0);
-  /* #ffffff 抬起面/卡片 */
-  --bbi-surface-2: oklch(0.945 0.006 90);
-  /* #eeede8 次级面/输入框 */
-  --bbi-ink: oklch(0.252 0.056 264);
-  /* #14213d 海军蓝墨 · 主文字 */
-  --bbi-ink-soft: oklch(0.46 0.04 264);
-  /* #4d586f 次级文字 */
-  --bbi-ink-muted: oklch(0.62 0.03 264);
-  /* #7d8699 弱化/占位 */
-  --bbi-accent: oklch(0.57 0.13 62);
-  /* #ac6304 深金 · 强调(白字 AA) */
-  --bbi-accent-soft: oklch(0.57 0.13 62 / 0.12);
-  --bbi-accent-ink: oklch(1 0 0);
-  /* #ffffff 强调上的文字 */
-  --bbi-line: oklch(0.91 0.005 90);
-  /* #e2e1de 细线 */
-  --bbi-line-strong: oklch(0.87 0.006 90);
-  /* #d6d4d0 */
-  --bbi-danger: oklch(0.52 0.18 25);
-  /* #ba2b2e 删除/警示(AA) */
-  --bbi-danger-soft: oklch(0.52 0.18 25 / 0.1);
-  --bbi-warning: oklch(0.55 0.1 75);
-  /* #936823 悬念/待办(AA) */
-  --bbi-warning-soft: oklch(0.55 0.1 75 / 0.12);
-  --bbi-overlay: oklch(0.252 0.056 264 / 0.34);
-  /* 遮罩 */
-  --bbi-shadow: 0 18px 48px -20px oklch(0.252 0.056 264 / 0.22),
-    0 4px 12px -6px oklch(0.252 0.056 264 / 0.1);
-}
-
-/* ========== 夜 · 海军黑 ==========
-   底色是深海军蓝(比纯黑更有层次、更高级),强调是明亮琥珀金,
-   金按钮上压深 navy 字。黑金优雅的标准用法,提气而不刺眼。
-   对比度(主底为基准):ink 15.3、ink-soft 8.2、ink-muted 4.4、accent 9.3。 */
-.bbi-root[data-theme='night'] {
-  --bbi-bg: #37353E;
-  --bbi-surface: #44444E;
-  --bbi-surface-2: #4E4D58;
-  --bbi-ink: #D3DAD9;
-  --bbi-ink-soft: #B0B5B4;
-  --bbi-ink-muted: #8E9392;
-  --bbi-accent: #76ABAE;
-  --bbi-accent-soft: #76ABAE26;
-  /* 15% opacity */
-  --bbi-accent-ink: #2C3536;
-  --bbi-line: #53525D;
-  --bbi-line-strong: #686774;
-  --bbi-danger: #D96B6B;
-  --bbi-danger-soft: #D96B6B26;
-  /* 15% opacity */
-  --bbi-warning: #D9B358;
-  --bbi-warning-soft: #D9B35826;
-  /* 15% opacity */
-  --bbi-overlay: #1F1E2499;
-  /* 60% opacity */
-  --bbi-shadow: 0 20px 56px -22px #000000A6, 0 4px 14px -8px #00000080;
-}
-
-/* ========== 粉彩 ==========
-   独立主题,不分昼夜。薰衣草粉纸底 + 玫瑰强调,梦幻而不失可读性。
-   梦幻的薰衣草/天蓝/婴儿粉太浅,只用于底/线/染色;文字与强调用够深的梅紫/玫瑰,
-   保证 WCAG AA。对比度(主底为基准):ink 10.5、ink-soft 5.3、ink-muted 3.2、accent 4.3。 */
-.bbi-root[data-theme='pastel'] {
-  --bbi-bg: oklch(0.975 0.012 330);
-  /* #fcf4fb 薰衣草粉纸 */
-  --bbi-surface: oklch(1 0 0);
-  /* #ffffff 抬起面/卡片 */
-  --bbi-surface-2: oklch(0.955 0.022 335);
-  /* #faebf6 次级面/输入框 */
-  --bbi-ink: oklch(0.36 0.09 330);
-  /* #572953 深梅紫 · 主文字 */
-  --bbi-ink-soft: oklch(0.52 0.08 330);
-  /* #83587f 次级文字 */
-  --bbi-ink-muted: oklch(0.64 0.07 330);
-  /* #a57da1 弱化/占位 */
-  --bbi-accent: #ffafcc;
-  /* #c4486d 玫瑰 · 强调(双用:底/文字均 AA) */
-  --bbi-accent-soft: oklch(0.58 0.16 5 / 0.12);
-  --bbi-accent-ink: oklch(1 0 0);
-  /* #ffffff 强调上的文字 */
-  --bbi-line: oklch(0.91 0.025 330);
-  /* #ebdce9 细线 */
-  --bbi-line-strong: oklch(0.86 0.035 335);
-  /* #e0c9da */
-  --bbi-danger: oklch(0.55 0.19 15);
-  /* #c72c4c 删除/警示(AA) */
-  --bbi-danger-soft: oklch(0.55 0.19 15 / 0.1);
-  --bbi-warning: oklch(0.62 0.12 70);
-  /* #b47825 悬念/待办(AA) */
-  --bbi-warning-soft: oklch(0.62 0.12 70 / 0.12);
-  --bbi-overlay: oklch(0.36 0.09 330 / 0.32);
-  /* 遮罩 */
-  --bbi-shadow: 0 18px 48px -20px oklch(0.45 0.15 350 / 0.3),
-    0 4px 12px -6px oklch(0.45 0.15 350 / 0.16);
-}
-
-/* 粉彩强调色是浅粉(#ffafcc),原生 accent-color 复选框会按浅底自动把勾翻成黑色。
-   仅在本主题下把复选框改为自绘:浅粉底 + 强制白色对勾。作用域限定 pastel,不影响其他主题。 */
-.bbi-root[data-theme='pastel'] .bbi-checkbox {
-  appearance: none;
-  -webkit-appearance: none;
-  border: 1.5px solid var(--bbi-line-strong);
-  border-radius: 4px;
-  background: var(--bbi-surface);
-}
-
-.bbi-root[data-theme='pastel'] .bbi-checkbox:checked {
-  border-color: var(--bbi-accent);
