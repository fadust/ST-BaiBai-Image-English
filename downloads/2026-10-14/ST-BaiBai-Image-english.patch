+  background: var(--bbi-surface-2);
+}
+.bbi-combo-item.is-selected {
+  color: var(--bbi-accent);
+  font-weight: 600;
+}
+.bbi-combo-empty {
+  padding: 6px 10px;
+  font-size: 12px;
+  color: var(--bbi-ink-muted);
