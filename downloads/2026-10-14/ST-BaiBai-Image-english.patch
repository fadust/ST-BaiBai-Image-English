+++ b/localization/english.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from 'vitest';
+import upstream from './upstream-macros.json';
+import * as defaults from '../src/state/settings';
+import { expandNlSections, RULE_ENGLISH_OUTPUT } from '../src/autoTag/prompt';
+import { normalizeOrientation } from '../src/backends/size';
+
+describe('English prompt and saved-data contracts', () => {
+  it('preserves macro counts and order in every built-in prompt', () => {
+    for (const [name, macros] of Object.entries(upstream)) {
+      const text = (defaults as unknown as Record<string, string>)[name];
+      expect(text.match(/\{\{[^}]+\}\}/g) ?? [], name).toEqual(macros);
+    }
+  });
+  it('fully expands both natural-language modes without leaving conditional markers', () => {
+    for (const enabled of [true, false]) for (const text of [defaults.DEFAULT_NAI_V5_THINKING, defaults.DEFAULT_NAI_V5_SPEC]) {
+      expect(expandNlSections(text, enabled)).not.toMatch(/\{\{[#^/]nl\}\}/);
+    }
+  });
+  it('requires English prose while keeping proper names and wire fields intact', () => {
+    expect(RULE_ENGLISH_OUTPUT).toContain('Use English');
+    expect(RULE_ENGLISH_OUTPUT).toContain('Preserve proper names');
+    expect(RULE_ENGLISH_OUTPUT).toContain('JSON keys');
+    expect(normalizeOrientation('横屏构图')).toBe('landscape');
+    expect(normalizeOrientation('horizontal composition')).toBe('landscape');
+  });
+});
diff --git a/localization/names.test.ts b/localization/names.test.ts
new file mode 100644
index 0000000..f12cf13
--- /dev/null
+++ b/localization/names.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from 'vitest';
+import { parseImagePlan } from '../src/autoTag/protocol';
+
+describe('English source names', () => {
+  it('recovers source casing and typography for saved entries and character prompts', () => {
+    const segments = [{ id: 'P1', sourceLine: 0, text: 'Rowan O’Connor waits beside Alexandra Montgomery-Smythe.' }];
+    const plan = parseImagePlan(JSON.stringify({
+      images: [{ position: 'P1', tag: '2people', characters: [{ name: "rowan o'connor", tag: 'boy' }] }],
+      changes: [{ name: "Rowan O'Connor", field: 'new', fields: { hair: 'short hair', eyes: 'green eyes' } }],
+    }), segments, 0, 1);
+    expect(plan.images[0].characters[0].name).toBe('Rowan O’Connor');
+    expect(plan.changes[0].name).toBe('Rowan O’Connor');
+  });
+  it('does not guess between different source spellings or transliterate a new name', () => {
+    const plan = parseImagePlan(JSON.stringify({ images: [], changes: [
+      { name: "rowan o'connor", field: 'hair', value: 'short hair', position: 'P1' },
+      { name: 'Snow', field: 'hair', value: 'short hair', position: 'P1' },
+    ] }), [{ id: 'P1', sourceLine: 0, text: "Rowan O’Connor meets Rowan O'Connor and 小雪." }], 0, 1);
+    expect(plan.changes.map(change => change.name)).toEqual(["rowan o'connor", 'Snow']);
+  });
+});
