+  backend: 'nai' | 'comfyui';
+  model: string;
+  prompt: string;
+  nl: string;
+  negative: string;
+  characters: ImageCharacterPrompt[];
+  seed: number;
+  size: Orientation;
+  floor: number;
+  seq: number;
