+import type { ChatMsg } from '@/api/client';
+import type { ImageCharacterPrompt } from '@/autoTag/protocol';
+import type { Orientation } from '@/backends/size';
+
+/**
+ * 请求历史(副 API 推理 + 生图)的模块级内存 store。
