+ */
+const MAX_CONTENT = 20_000;
+
+export type HistoryKind = 'llm' | 'image';
+
+/** running 是进行中;aborted 是用户主动取消(与 error 分开,不是故障)。 */
+export type HistoryStatus = 'running' | 'ok' | 'error' | 'aborted';
