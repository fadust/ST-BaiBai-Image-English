+    toastr?.info?.('Discarded all rewrite results; the original message is unchanged', 'BaiBai Inkwell');
+    return;
+  }
+  const accepted = new Map(
+    rewriteChanges.value
+      .filter(change => reviewDecision.value[change.paragraph] === 'accept')
