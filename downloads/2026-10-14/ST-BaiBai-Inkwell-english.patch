+function versionLessThan(current: string, required: string): boolean {
+  const left = parseVersion(current);
+  const right = parseVersion(required);
+  for (let index = 0; index < 3; index += 1) {
+    const a = left[index] ?? 0;
+    const b = right[index] ?? 0;
+    if (a !== b) return a < b;
+  }
+  return false;
