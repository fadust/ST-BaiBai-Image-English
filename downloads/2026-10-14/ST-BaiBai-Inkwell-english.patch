+interface SharedChannelsStore {
+  schemaVersion: number;
+  revision: number;
+  channels: ApiChannel[];
+}
+
+interface STContext {
+  extensionSettings?: Record<string, unknown>;
+  saveSettingsDebounced?: () => void;
+  getRequestHeaders?: () => Record<string, string>;
+}
